{
  "manifest_version": 3,
  "name": "Roblox PNG Downloader",
  "version": "1.0",

  "permissions": [
    "downloads",
    "tabs"
  ],

  "host_permissions": [
    "https://*.roblox.com/*",
    "https://assetdelivery.roblox.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://www.roblox.com/*"],
      "js": ["content.js"]
    }
  ],
  
  "action": {
      "default_popup": "popup.html"
  }
}